
<div class="page-header">
  <div>
    <h1>Academic Results</h1>
    <p class="page-description">Record and review student marks and grades.</p>
  </div>
  <%= link_to "＋ Record Result", new_result_path, class: "btn btn-primary" %>
</div>

<% if flash[:alert].present? %>
  <div class="alert alert-error" role="alert"><%= flash[:alert] %></div>
<% end %>
<% if flash[:notice].present? %>
  <div class="notice" role="status"><%= flash[:notice] %></div>
<% end %>

<div class="card">
  <% if @results.any? %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Student Number</th>
            <th>Student Name</th>
            <th>Unit</th>
            <th>Semester</th>
            <th>Academic Year</th>
            <th>Mark</th>
            <th>Grade</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @results.each do |result| %>
            <% enrolment = result.enrolment %>
            <% student = enrolment.student %>
            <% unit = enrolment.unit %>
            <tr>
              <td><%= student.student_number %></td>
              <td><%= link_to "#{student.first_name} #{student.last_name}", student_path(student), class: "action-link" %></td>
              <td><%= link_to "#{unit.code} — #{unit.name}", unit_path(unit), class: "action-link" %></td>
              <td><%= enrolment.semester %></td>
              <td><%= enrolment.academic_year %></td>
              <td><%= result.mark %></td>
              <td><%= result.grade %></td>
              <td class="table-actions">
                <%= link_to "View", result_path(result), class: "action-link" %>
                <%= link_to "Edit", edit_result_path(result), class: "action-link" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h3>No results available</h3>
      <p>Academic results will appear here once they are recorded.</p>
    </div>
  <% end %>
</div>

<%= link_to "← Back to Dashboard", root_path, class: "action-link" %>
