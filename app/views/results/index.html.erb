
<div class="page-header">
  <div>
    <h1>Academic Results</h1>
    <p class="page-description">View student marks and grades.</p>
  </div>
</div>

<div class="card">
  <% if @results.any? %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Student Number</th>
            <th>Student Name</th>
            <th>Unit</th>
            <th>Semester</th>
            <th>Academic Year</th>
            <th>Mark</th>
            <th>Grade</th>
          </tr>
        </thead>
        <tbody>
          <% @results.each do |result| %>
            <% enrolment = result.enrolment %>
            <% student = enrolment.student %>
            <% unit = enrolment.unit %>
            <tr>
              <td><%= student.student_number %></td>
              <td><%= "#{student.first_name} #{student.last_name}" %></td>
              <td><%= unit.code %> — <%= unit.name %></td>
              <td><%= enrolment.semester %></td>
              <td><%= enrolment.academic_year %></td>
              <td><%= result.mark %></td>
              <td><%= result.grade %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h3>No results available</h3>
      <p>Academic results will appear here once they are recorded.</p>
    </div>
  <% end %>
</div>

<%= link_to "← Back to Dashboard", root_path, class: "action-link" %>
