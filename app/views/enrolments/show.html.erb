<div class="page-header">
  <div>
    <h1>Enrolment Details</h1>
    <p class="page-description">Student unit enrolment and academic result.</p>
  </div>
  <div class="form-actions">
    <%= link_to "Student Record", student_path(@enrolment.student), class: "btn btn-primary" %>
    <%= link_to "All Enrolments", enrolments_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card student-details-card">
  <div class="details-grid">
    <div class="detail-item">
      <span class="detail-label">Student</span>
      <span class="detail-value"><%= link_to "#{@enrolment.student.student_number} — #{@enrolment.student.first_name} #{@enrolment.student.last_name}", student_path(@enrolment.student), class: "action-link" %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Unit</span>
      <span class="detail-value"><%= link_to "#{@enrolment.unit.code} — #{@enrolment.unit.name}", unit_path(@enrolment.unit), class: "action-link" %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Semester</span>
      <span class="detail-value"><%= @enrolment.semester %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Academic Year</span>
      <span class="detail-value"><%= @enrolment.academic_year %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Unit Credits</span>
      <span class="detail-value"><%= @enrolment.unit.credit %></span>
    </div>
    <% if @enrolment.result %>
      <div class="detail-item">
        <span class="detail-label">Mark / Grade</span>
        <span class="detail-value"><%= @enrolment.result.mark %> / <%= @enrolment.result.grade %></span>
      </div>
    <% end %>
  </div>
</div>

<% if @enrolment.result %>
  <div class="alert" role="status">This enrolment has a recorded academic result and cannot be removed.</div>
<% else %>
  <%= button_to "Remove Enrolment", enrolment_path(@enrolment), method: :delete,
        class: "btn btn-secondary",
        form: { data: { turbo_confirm: "Remove this unit enrolment?" } } %>
<% end %>