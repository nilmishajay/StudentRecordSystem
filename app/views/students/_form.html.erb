<div class="card student-form-card">
  <%= form_with model: student do |form| %>
    <% if student.errors.any? %>
      <div class="alert alert-error" role="alert">
        <h3>
          Please correct the following
          <%= pluralize(student.errors.count, "error") %>:
        </h3>

        <ul>
          <% student.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :student_number, "Student Number" %>
      <%= form.text_field :student_number,
            placeholder: "e.g. ECU2026001",
            required: true,
            class: "form-control" %>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= form.label :first_name, "First Name" %>
        <%= form.text_field :first_name,
              placeholder: "Enter first name",
              required: true,
              class: "form-control" %>
      </div>

      <div class="form-group">
        <%= form.label :last_name, "Last Name" %>
        <%= form.text_field :last_name,
              placeholder: "Enter last name",
              required: true,
              class: "form-control" %>
      </div>
    </div>

    <div class="form-group">
      <%= form.label :email, "Email Address" %>
      <%= form.email_field :email,
            placeholder: "student@example.com",
            required: true,
            class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :course_id, "Course" %>
      <%= form.collection_select :course_id,
            Course.order(:name),
            :id,
            :name,
            { prompt: "Select a course" },
            { required: true, class: "form-control" } %>
    </div>

    <div class="form-actions">
      <%= form.submit(student.persisted? ? "Update Student" : "Create Student", class: "btn btn-primary") %>
      <%= link_to "Cancel", student.persisted? ? student_path(student) : students_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

<%= link_to "← Back to Students", students_path, class: "action-link" %>