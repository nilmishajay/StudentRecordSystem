
<div class="page-header">
  <div>
    <h1>Students</h1>
    <p class="page-description">Manage student academic records.</p>
  </div>

  <%= link_to "＋ Add Student", new_student_path, class: "btn btn-primary" %>
</div>

<% if flash[:alert].present? %>
  <div class="alert alert-error" role="alert"><%= flash[:alert] %></div>
<% end %>

<% if flash[:notice].present? %>
  <div class="notice" role="status"><%= flash[:notice] %></div>
<% end %>

<div class="card">
  <% if @students.any? %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Student Number</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Course</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @students.each do |student| %>
            <tr>
              <td><%= student.student_number %></td>
              <td><%= "#{student.first_name} #{student.last_name}" %></td>
              <td><%= student.email %></td>
              <td><%= student.course&.name || "Not assigned" %></td>
              <td class="table-actions">
                <%= link_to "View", student_path(student), class: "action-link" %>
                <%= link_to "Edit", edit_student_path(student), class: "action-link" %>
                <%= button_to "Delete", student_path(student),
                      method: :delete,
                      class: "action-link action-delete",
                      form: { data: { turbo_confirm: "Delete this student?" } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h3>No students registered yet</h3>
      <p>Add your first student to begin managing academic records.</p>
      <%= link_to "Add Student", new_student_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
