<div class="page-header">
  <div>
    <h1>Student Details</h1>
    <p class="page-description">
      View the student's personal and academic information.
    </p>
  </div>

  <div class="form-actions">
    <%= link_to "Edit Student", edit_student_path(@student), class: "btn btn-primary" %>
    <%= link_to "Back to Students", students_path, class: "btn btn-secondary" %>
  </div>
</div>

<% if flash[:alert].present? %>
  <div class="alert alert-error" role="alert"><%= flash[:alert] %></div>
<% end %>
<% if flash[:notice].present? %>
  <div class="notice" role="status"><%= flash[:notice] %></div>
<% end %>

<div class="card student-details-card">
  <h2>
    <%= @student.first_name %> <%= @student.last_name %>
  </h2>

  <div class="details-grid">
    <div class="detail-item">
      <span class="detail-label">Student Number</span>
      <span class="detail-value"><%= @student.student_number %></span>
    </div>

    <div class="detail-item">
      <span class="detail-label">Email Address</span>
      <span class="detail-value"><%= @student.email %></span>
    </div>

    <div class="detail-item">
      <span class="detail-label">Course</span>
      <span class="detail-value"><%= @student.course.name %></span>
    </div>

    <div class="detail-item">
      <span class="detail-label">Course Code</span>
      <span class="detail-value"><%= @student.course.code %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Weighted Average Mark (WAM)</span>
      <span class="detail-value"><%= @wam ? format("%.2f", @wam) : "Not available" %></span>
    </div>
  </div>
</div>

<div class="card">
  <div class="page-header">
    <div>
      <h2>Academic Record</h2>
      <p class="page-description">Unit enrolments by semester and academic year.</p>
    </div>
    <%= link_to "＋ Enrol in Unit", new_enrolment_path(student_id: @student.id), class: "btn btn-primary" %>
  </div>

  <% if @enrolments.any? %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Unit Code</th>
            <th>Unit Name</th>
            <th>Credits</th>
            <th>Semester</th>
            <th>Academic Year</th>
            <th>Mark</th>
            <th>Grade</th>
            <th>Result Status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @enrolments.each do |enrolment| %>
            <tr>
              <td><%= link_to enrolment.unit.code, unit_path(enrolment.unit), class: "action-link" %></td>
              <td><%= enrolment.unit.name %></td>
              <td><%= enrolment.unit.credit %></td>
              <td><%= enrolment.semester %></td>
              <td><%= enrolment.academic_year %></td>
              <td><%= enrolment.result&.mark || "—" %></td>
              <td><%= enrolment.result&.grade || "—" %></td>
              <td><%= enrolment.result ? "Recorded" : "No result recorded" %></td>
              <td class="table-actions">
                <%= link_to "Details", enrolment_path(enrolment), class: "action-link" %>
                <% if enrolment.result %>
                  <%= link_to "Edit Result", edit_result_path(enrolment.result), class: "action-link" %>
                <% else %>
                  <%= link_to "Record Result", new_result_path(enrolment_id: enrolment.id), class: "action-link" %>
                  <%= button_to "Remove", enrolment_path(enrolment), method: :delete,
                        class: "action-link action-delete",
                        form: { data: { turbo_confirm: "Remove this unit enrolment?" } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="page-description">
      No units have been enrolled for this student yet.
    </p>
    <%= link_to "Enrol in a Unit", new_enrolment_path(student_id: @student.id), class: "btn btn-primary" %>
  <% end %>
</div>
