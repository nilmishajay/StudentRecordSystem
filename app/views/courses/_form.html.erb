<div class="card student-form-card">
  <%= form_with model: course do |form| %>
    <% if course.errors.any? %>
      <div class="alert alert-error" role="alert">
        <h3>Please correct the following <%= pluralize(course.errors.count, "error") %>:</h3>
        <ul>
          <% course.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :code, "Course Code" %>
      <%= form.text_field :code, required: true, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :name, "Course Name" %>
      <%= form.text_field :name, required: true, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :description %>
      <%= form.text_area :description, rows: 5, class: "form-control" %>
    </div>

    <div class="form-actions">
      <%= form.submit(course.persisted? ? "Update Course" : "Create Course", class: "btn btn-primary") %>
      <%= link_to "Cancel", course.persisted? ? course_path(course) : courses_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

<%= link_to "← Back to Courses", courses_path, class: "action-link" %>