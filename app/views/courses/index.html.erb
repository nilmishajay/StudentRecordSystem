
<div class="page-header">
  <div>
    <h1>Courses</h1>
    <p class="page-description">Manage courses and their students and units.</p>
  </div>
  <%= link_to "＋ Add Course", new_course_path, class: "btn btn-primary" %>
</div>

<% if flash[:alert].present? %>
  <div class="alert alert-error" role="alert"><%= flash[:alert] %></div>
<% end %>
<% if flash[:notice].present? %>
  <div class="notice" role="status"><%= flash[:notice] %></div>
<% end %>

<div class="card">
  <% if @courses.any? %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Course Code</th>
            <th>Course Name</th>
            <th>Students</th>
            <th>Units</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @courses.each do |course| %>
            <tr>
              <td><%= course.code %></td>
              <td><%= course.name %></td>
              <td><%= course.students.count %></td>
              <td><%= course.units.count %></td>
              <td>
                <%= link_to "View", course_path(course), class: "action-link" %>
                <%= link_to "Edit", edit_course_path(course), class: "action-link" %>
                <%= button_to "Delete", course_path(course), method: :delete,
                      class: "action-link action-delete",
                      form: { data: { turbo_confirm: "Delete this course?" } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h3>No courses available</h3>
      <p>Create a course to begin organizing students and academic units.</p>
      <%= link_to "Add Course", new_course_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<%= link_to "← Back to Dashboard", root_path, class: "action-link" %>
