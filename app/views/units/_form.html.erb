<div class="card student-form-card">
  <%= form_with model: unit do |form| %>
    <% if unit.errors.any? %>
      <div class="alert alert-error" role="alert">
        <h3>Please correct the following <%= pluralize(unit.errors.count, "error") %>:</h3>
        <ul>
          <% unit.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :code, "Unit Code" %>
      <%= form.text_field :code, required: true, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :name, "Unit Name" %>
      <%= form.text_field :name, required: true, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :credit, "Credits" %>
      <%= form.number_field :credit, min: 1, step: 1, required: true, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :course_id, "Course" %>
      <%= form.collection_select :course_id, Course.order(:name), :id, :name,
            { prompt: "Select a course" }, { required: true, class: "form-control" } %>
    </div>

    <div class="form-actions">
      <%= form.submit(unit.persisted? ? "Update Unit" : "Create Unit", class: "btn btn-primary") %>
      <%= link_to "Cancel", unit.persisted? ? unit_path(unit) : units_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

<%= link_to "← Back to Units", units_path, class: "action-link" %>