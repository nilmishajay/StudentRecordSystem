
<section class="dashboard-page" aria-labelledby="dashboard-title">
  <div class="dashboard-welcome">
    <div>
      <p class="eyebrow">Academic records overview</p>
      <h1 id="dashboard-title">Welcome back, <%= current_user.username %></h1>
      <p class="page-description">Manage student, course, enrolment, and assessment records from one place.</p>
    </div>
    <%= link_to "＋ Add Student", new_student_path, class: "btn btn-primary" %>
  </div>

  <section aria-labelledby="records-heading">
    <div class="section-heading">
      <div>
        <h2 id="records-heading">Records at a glance</h2>
        <p class="page-description">Current totals from the records database.</p>
      </div>
    </div>
    <div class="stats-grid">
      <% [
        ["Students", @student_count, students_path, "students"],
        ["Courses", @course_count, courses_path, "courses"],
        ["Units", @unit_count, units_path, "units"],
        ["Enrolments", @enrolment_count, enrolments_path, "enrolments"],
        ["Results", @result_count, results_path, "results"]
      ].each do |label, count, path, icon| %>
        <%= link_to path, class: "stat-card", aria: { label: "#{label}: #{count}. Open #{label.downcase}." } do %>
          <span class="stat-icon"><%= navigation_icon(icon) %></span>
          <span class="stat-label"><%= label %></span>
          <span class="stat-number"><%= count %></span>
          <span class="stat-caption"><%= count.zero? ? "No records yet" : "View records" %></span>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="quick-actions-section" aria-labelledby="quick-actions-title">
    <div class="section-heading">
      <div>
        <h2 id="quick-actions-title">Manage records</h2>
        <p class="page-description">Choose an area to review or update.</p>
      </div>
    </div>
    <div class="quick-actions-grid">
      <% [
        ["Students", "Review profiles and academic records.", students_path, "students"],
        ["Courses", "Maintain course information and units.", courses_path, "courses"],
        ["Units", "Review units and credit values.", units_path, "units"],
        ["Enrolments", "Manage student unit enrolments by term.", enrolments_path, "enrolments"],
        ["Results", "Record and review marks and grades.", results_path, "results"]
      ].each do |label, description, path, icon| %>
        <%= link_to path, class: "quick-action-card" do %>
          <span class="quick-action-icon"><%= navigation_icon(icon) %></span>
          <span class="quick-action-copy"><strong><%= label %></strong><span><%= description %></span></span>
          <span class="quick-action-arrow" aria-hidden="true">→</span>
        <% end %>
      <% end %>
    </div>
  </section>
</section>
