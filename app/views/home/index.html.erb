<div class="dashboard">

  <header class="dashboard-header">
    <div>
      <h1>Student Record System</h1>
      <p>Academic Records Dashboard</p>
    </div>

    <div class="user-info">
      <span>
        <strong><%= current_user.username %></strong>
        (<%= current_user.role.capitalize %>)
      </span>

      <%= button_to "Logout", logout_path, method: :delete, class: "logout-button" %>
    </div>
  </header>

  <main class="dashboard-content">

    <% if flash[:notice] %>
      <div class="notice">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <section class="welcome-section">
      <h2>Dashboard</h2>
      <p>
        Welcome back, <strong><%= current_user.username %></strong>.
        Manage and view academic records from one place.
      </p>
    </section>

    <section class="statistics">

      <div class="stat-card">
        <h3>Students</h3>
        <p><%= @student_count %></p>
      </div>

      <div class="stat-card">
        <h3>Courses</h3>
        <p><%= @course_count %></p>
      </div>

      <div class="stat-card">
        <h3>Units</h3>
        <p><%= @unit_count %></p>
      </div>

      <div class="stat-card">
        <h3>Results</h3>
        <p><%= @result_count %></p>
      </div>

    </section>

    <section class="quick-actions">
      <h2>Quick Actions</h2>

      <div class="action-grid">

        <a href="#" class="action-card">
          <h3>Students</h3>
          <p>View and manage student records.</p>
        </a>

        <a href="#" class="action-card">
          <h3>Courses</h3>
          <p>View available courses.</p>
        </a>

        <a href="#" class="action-card">
          <h3>Units</h3>
          <p>View academic units.</p>
        </a>

        <a href="#" class="action-card">
          <h3>Results</h3>
          <p>View academic results.</p>
        </a>

      </div>
    </section>

  </main>

</div>
