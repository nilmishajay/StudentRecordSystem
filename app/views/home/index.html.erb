
<div class="dashboard-container">

  <div class="dashboard-header">
    <h1>Dashboard</h1>
    <p>
      Welcome back, <strong><%= current_user.username %></strong>.
      Manage and view academic records from one place.
    </p>
  </div>

  <!-- Dashboard statistics -->
  <div class="stats-grid">

    <%= link_to students_path, class: "stat-card" do %>
      <h3>Students</h3>
      <p class="stat-number"><%= Student.count %></p>
    <% end %>

    <%= link_to courses_path, class: "stat-card" do %>
      <h3>Courses</h3>
      <p class="stat-number"><%= Course.count %></p>
    <% end %>

    <%= link_to units_path, class: "stat-card" do %>
      <h3>Units</h3>
      <p class="stat-number"><%= Unit.count %></p>
    <% end %>

    <%= link_to results_path, class: "stat-card" do %>
      <h3>Results</h3>
      <p class="stat-number"><%= Result.count %></p>
    <% end %>

  </div>

  <!-- Quick actions -->
  <section class="quick-actions-section">
    <h2>Quick Actions</h2>

    <div class="quick-actions-grid">

      <%= link_to students_path, class: "quick-action-card" do %>
        <h3>Students</h3>
        <p>View and manage student records.</p>
        <span>Manage Students →</span>
      <% end %>

      <%= link_to courses_path, class: "quick-action-card" do %>
        <h3>Courses</h3>
        <p>View and manage available courses.</p>
        <span>Manage Courses →</span>
      <% end %>

      <%= link_to units_path, class: "quick-action-card" do %>
        <h3>Units</h3>
        <p>View and manage academic units.</p>
        <span>Manage Units →</span>
      <% end %>

      <%= link_to results_path, class: "quick-action-card" do %>
        <h3>Results</h3>
        <p>View and manage academic results.</p>
        <span>Manage Results →</span>
      <% end %>

    </div>
  </section>

</div>
